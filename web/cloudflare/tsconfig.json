{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "paths": {
      "@growthx/storage": [
        "./storage.ts"
      ],
      "@growthx/catalog": [
        "./catalog.ts"
      ],
      "@growthx/dns": [
        "./dns.ts"
      ],
      "@/*": [
        "../*"
      ]
    }
  },
  "include": [
    "worker.ts",
    "storage.ts",
    "catalog.ts",
    "dns.ts"
  ]
}
