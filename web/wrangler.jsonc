{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "growthx-event-team",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "3284e03dca57951fd16ab93c51725c47",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "alias": {
    "@growthx/storage": "./cloudflare/storage.ts",
    "@growthx/catalog": "./cloudflare/catalog.ts",
    "@growthx/dns": "./cloudflare/dns.ts"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "EventWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EventWorkspace"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
