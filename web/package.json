{
  "name": "speed-hack-event-gtm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --webpack -p 3010",
    "build": "node scripts/copy-maplibre-worker.mjs && next build --webpack",
    "start": "next start -p 3010",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/run-agent-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "lint": "eslint .",
    "build:cloudflare": "node scripts/copy-maplibre-worker.mjs && node --import tsx scripts/export-cloudflare-catalog.ts && vite build --config cloudflare/vite.config.ts",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "dev:cloudflare": "wrangler dev"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "lucide-react": "1.17.0",
    "maplibre-gl": "6.9.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "playwright": "1.58.2",
    "tsx": "^4.20.0",
    "typescript": "5.7.3",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  },
  "packageManager": "pnpm@11.8.0"
}
